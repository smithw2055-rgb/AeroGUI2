@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if(NOT EMSCRIPTEN)
    find_dependency(Threads)
endif()

if(NOT TARGET RealScript::SlimRuntime)
    if(NOT RealScript_DIR AND NOT "@REALSCRIPT_CONFIG_HINT_DIR@" STREQUAL "" AND EXISTS "@REALSCRIPT_CONFIG_HINT_DIR@/RealScriptConfig.cmake")
        set(RealScript_DIR "@REALSCRIPT_CONFIG_HINT_DIR@")
    endif()
    find_dependency(RealScript CONFIG)
endif()

if(NOT TARGET AeroGUI::Runtime)
    include("${CMAKE_CURRENT_LIST_DIR}/AeroGUI2Targets.cmake")
endif()

if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/AeroSampleApp.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/AeroSampleApp.cmake")
endif()

set(AeroGUI2_VERSION "@PROJECT_VERSION@")
set(AeroGUI2_HAS_COMPILER_TOOLS @AERO_HAS_COMPILER_TOOLS_CMAKE@)
check_required_components(AeroGUI2)

<Page
  x:Class="Menu3D.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
  xmlns:noesis="clr-namespace:NoesisGUIExtensions"
  mc:Ignorable="d"
  d:DesignWidth="1920"
  d:DesignHeight="1080"
  d:DataContext="ViewModel Data"
  Title="NoesisGUI - Menu3D"
  Foreground="{DynamicResource Menu3D.Brush.TransparentWhite95}"
  FontFamily="{DynamicResource Menu3D.Font.Default}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="1*"/>
      <RowDefinition Height="9*"/>
      <RowDefinition Height="1*"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="1*"/>
      <ColumnDefinition Width="5*"/>
      <ColumnDefinition Width="1*"/>
    </Grid.ColumnDefinitions>
    <ContentControl x:Name="AnimatedBackground" Margin="0,0,0,-1" Grid.ColumnSpan="3" Grid.RowSpan="3" ContentTemplate="{StaticResource Menu3D.Template.AnimatedBackground}"/>
    <ContentControl x:Name="NavigationRoot" Content="{Binding Path=MainMenu}" Grid.Column="1" Grid.Row="1" Template="{StaticResource Menu3D.Template.NavigationRoot}" ContentTemplate="{DynamicResource Menu3D.Template.MainMenu}">
      <noesis:Navigation.Destinations>
        <noesis:NavDestination Id="Main" Content="{Binding Path=MainMenu}" ContentTemplate="{StaticResource Menu3D.Template.MainMenu}"/>
        <noesis:NavDestination Id="Start" Content="{Binding Path=StartMenu}" ContentTemplate="{StaticResource Menu3D.Template.StartMenu}"/>
        <noesis:NavDestination Id="Settings" Content="{Binding Path=SettingsMenu}" ContentTemplate="{StaticResource Menu3D.Template.SettingsMenu}"/>
      </noesis:Navigation.Destinations>
    </ContentControl>
  </Grid>
</Page>

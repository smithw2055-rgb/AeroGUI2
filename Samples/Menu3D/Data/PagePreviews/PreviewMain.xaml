<Page
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:noesis="clr-namespace:NoesisGUIExtensions"
  mc:Ignorable="d"
  d:DesignWidth="1920"
  d:DesignHeight="1080" Foreground="{DynamicResource Menu3D.Brush.TransparentWhite95}" FontFamily="{DynamicResource Menu3D.Font.Default}" d:DataContext="ViewModel Data">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="1*"/>
      <ColumnDefinition Width="5*"/>
      <ColumnDefinition Width="1*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="1*"/>
      <RowDefinition Height="9*"/>
      <RowDefinition Height="1*"/>
    </Grid.RowDefinitions>
    <ContentControl x:Name="AnimatedBackground" Grid.ColumnSpan="3" Grid.RowSpan="3" ContentTemplate="{StaticResource Menu3D.Template.AnimatedBackground}"/>
    <ContentControl Content="{Binding Path=MainMenu}" Grid.Column="1" Grid.Row="1" ContentTemplate="{DynamicResource Menu3D.Template.MainMenu}"/>
  </Grid>
</Page>
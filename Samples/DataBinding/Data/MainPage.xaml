<Page
  x:Class="DataBinding.MainWindow"
  x:DataType="DataBinding::ViewModel"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  xmlns:noesis="clr-namespace:NoesisGUIExtensions"
  Title="NoesisGUI - Solar System"
  Background="#FF060C17"
  d:DesignWidth="1920" d:DesignHeight="1080"
  d:DataContext="Solar System">
  <Page.Resources>
    <Storyboard x:Key="HideToolTip">
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BgCtrl" Storyboard.TargetProperty="MinWidth">
        <DiscreteDoubleKeyFrame KeyTime="0" Value="0"/>
        <DiscreteDoubleKeyFrame KeyTime="0:0:2" Value="1"/>
      </DoubleAnimationUsingKeyFrames>
    </Storyboard>
    <ControlTemplate x:Key="PlanetsListTemplate" TargetType="ListBox">
      <ItemsPresenter/>
    </ControlTemplate>
    <ItemsPanelTemplate x:Key="PlanetsListPanel">
      <Canvas/>
    </ItemsPanelTemplate>
    <ControlTemplate x:Key="PlanetContainerTemplate" TargetType="{x:Type ListBoxItem}">
      <Grid>
        <Ellipse Fill="SkyBlue" Margin="4" Opacity="0"/>
        <Ellipse x:Name="selectedPlanet" Margin="-10" IsHitTestVisible="False" />
        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsSelected" Value="true">
          <Setter Property="Stroke" TargetName="selectedPlanet" Value="#FF00DFFF"/>
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="PlanetContainerStyle" TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource {x:Type ListBoxItem}}">
      <Setter Property="Canvas.Left">
        <Setter.Value>
          <Binding Path="Orbit">
            <Binding.Converter>
              <noesis:MathConverter Expression="{}pow({0}/40,0.4)*770.0*0.707"/>
            </Binding.Converter>
          </Binding>
        </Setter.Value>
      </Setter>
      <Setter Property="Canvas.Bottom">
        <Setter.Value>
          <Binding Path="Orbit">
            <Binding.Converter>
              <noesis:MathConverter Expression="{}pow({0}/40,0.4)*770.0*0.707"/>
            </Binding.Converter>
          </Binding>
        </Setter.Value>
      </Setter>
      <Setter Property="Template" Value="{StaticResource PlanetContainerTemplate}"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="noesis:StyleInteraction.Triggers">
        <Setter.Value>
          <noesis:StyleTriggerCollection>
            <b:EventTrigger x:Name="FocusItemOnHover" EventName="MouseEnter">
              <b:ControlStoryboardAction Storyboard="{StaticResource HideToolTip}" ControlStoryboardOption="Stop"/>
              <noesis:SetFocusAction/>
            </b:EventTrigger>
            <b:EventTrigger x:Name="HideToolTipOnLeave" EventName="MouseLeave">
              <b:ControlStoryboardAction Storyboard="{StaticResource HideToolTip}"/>
            </b:EventTrigger>
            <b:DataTrigger x:Name="UnselectWhenUnfocused" Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="False">
              <b:ControlStoryboardAction Storyboard="{StaticResource HideToolTip}" ControlStoryboardOption="Stop"/>
              <b:ChangePropertyAction PropertyName="IsSelected" Value="False"/>
            </b:DataTrigger>
          </noesis:StyleTriggerCollection>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Panel.ZIndex" Value="100"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <DataTemplate x:Key="SolarSystemObjectTemplate">
      <Canvas Width="20" Height="20">
        <Ellipse Stroke="#BF36B1FF" StrokeThickness="0.5" IsHitTestVisible="False">
          <Ellipse.Height>
            <Binding Path="Orbit">
              <Binding.Converter>
                <noesis:MathConverter Expression="{}pow({0}/40,0.4)*770.0*2"/>
              </Binding.Converter>
            </Binding>
          </Ellipse.Height>
          <Ellipse.Width>
            <Binding Path="Orbit">
              <Binding.Converter>
                <noesis:MathConverter Expression="{}pow({0}/40,0.4)*770.0*2"/>
              </Binding.Converter>
            </Binding>
          </Ellipse.Width>
          <Canvas.Top>
            <Binding Path="Orbit">
              <Binding.Converter>
                <noesis:MathConverter Expression="{}pow({0}/40,0.4)*770.0*-0.293"/>
              </Binding.Converter>
            </Binding>
          </Canvas.Top>
          <Canvas.Left>
            <Binding Path="Orbit">
              <Binding.Converter>
                <noesis:MathConverter Expression="{}pow({0}/40,0.4)*770.0*-1.707"/>
              </Binding.Converter>
            </Binding>
          </Canvas.Left>
        </Ellipse>
        <Image Height="20" Width="20" Source="{Binding Path=Image}"/>
        <Popup x:Name="Tooltip" AllowsTransparency="True" HorizontalOffset="10" VerticalOffset="-20" PopupAnimation="Fade" Placement="Right">
          <Border BorderThickness="1,1,1,1" CornerRadius="8,8,8,8" BorderBrush="#20FFFFFF" Margin="10,0,10,20" IsHitTestVisible="False">
            <Border.Background>
              <RadialGradientBrush RadiusX="0.6126348" Center="0.5,0.687375" GradientOrigin="0.5,0.687375" RadiusY="0.92051816">
                <RadialGradientBrush.RelativeTransform>
                  <TransformGroup>
                    <ScaleTransform CenterY="0.535391" CenterX="0.5"/>
                    <SkewTransform CenterY="0.535391" CenterX="0.5"/>
                    <RotateTransform Angle="0.63170856" CenterY="0.68737465" CenterX="0.5"/>
                    <TranslateTransform/>
                  </TransformGroup>
                </RadialGradientBrush.RelativeTransform>
                <GradientStop Color="#FF1E3E80" Offset="0"/>
                <GradientStop Color="#FF030A25" Offset="1"/>
              </RadialGradientBrush>
            </Border.Background>
            <StackPanel Width="300">
              <StackPanel.Background>
                <ImageBrush ImageSource="{Binding Path=Image}" Stretch="Uniform" Viewbox="0,0,1,0.453739"/>
              </StackPanel.Background>
              <TextBlock FontFamily="./#Roboto" Padding="0,10,0,8" Text="{Binding Path=Name}" TextAlignment="Center" FontSize="28" FontWeight="DemiBold" FontStretch="Expanded" CharacterSpacing="200">
                <TextBlock.Foreground>
                  <LinearGradientBrush StartPoint="0.5,0.332804" EndPoint="0.5,0.68696">
                    <GradientStop Color="#FFFFFFFF" Offset="0"/>
                    <GradientStop Color="#A4FFFFFF" Offset="1"/>
                  </LinearGradientBrush>
                </TextBlock.Foreground>
              </TextBlock>
              <Border Padding="5,5,5,5" Margin="10,35,10,20" CornerRadius="5,5,5,5" BorderThickness="1,0,1,1" BorderBrush="#D00D0D35">
                <Border.Background>
                  <RadialGradientBrush RadiusX="1.1932818" Center="0.5,0.131218" GradientOrigin="0.5,0.131218" RadiusY="1.237027">
                    <RadialGradientBrush.RelativeTransform>
                      <TransformGroup>
                        <ScaleTransform CenterY="0.535391" CenterX="0.5"/>
                        <SkewTransform CenterY="0.535391" CenterX="0.5"/>
                        <RotateTransform Angle="36.06094" CenterY="0.13121839" CenterX="0.5"/>
                        <TranslateTransform/>
                      </TransformGroup>
                    </RadialGradientBrush.RelativeTransform>
                    <GradientStop Color="#FF1E3E80" Offset="0"/>
                    <GradientStop Color="#A4030A25" Offset="0.83100003"/>
                  </RadialGradientBrush>
                </Border.Background>
                <StackPanel>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Top">
                      <TextBlock Foreground="#FFFFFFFF" Text="Orbit" FontSize="14"/>
                      <TextBlock Foreground="#FFFFFFFF" Text="{Binding Path=Orbit}" FontSize="14" FontWeight="DemiBold" Margin="4,0,2,0"/>
                      <TextBlock Foreground="#FFFFFFFF" Text="AU" FontSize="14" FontWeight="DemiBold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="12,8,5,0" VerticalAlignment="Top">
                      <TextBlock Foreground="#FFFFFFFF" Text="Diameter" FontSize="14"/>
                      <TextBlock Foreground="#FFFFFFFF" Text="{Binding Path=Diameter}" FontSize="14" FontWeight="DemiBold" Margin="4,0,2,0"/>
                      <TextBlock Foreground="#FFFFFFFF" Text="Km" FontSize="14" FontWeight="DemiBold"/>
                    </StackPanel>
                  </StackPanel>
                  <Rectangle Fill="#FFF4F4F5" Height="0.5" Width="200" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,10" Opacity="0.35"/>
                  <TextBlock CharacterSpacing="20" Foreground="#FFFFFFFF" Text="{Binding Path=Details}" TextAlignment="Center" FontSize="14" TextWrapping="Wrap" FontWeight="DemiBold" Margin="0,0,0,10"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </Popup>
      </Canvas>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
          <Setter Property="IsOpen" Value="True" TargetName="Tooltip"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Page.Resources>
  <noesis:LayoutScaler ReferenceResolution="600,600">
    <Grid Background="Transparent">
      <b:Interaction.Triggers>
        <b:StoryboardCompletedTrigger x:Name="RemoveFocusWhenHidingToolTip" Storyboard="{StaticResource HideToolTip}">
          <b:ChangePropertyAction TargetName="BgCtrl" PropertyName="Focusable" Value="True"/>
          <noesis:SetFocusAction TargetName="BgCtrl"/>
          <b:ChangePropertyAction TargetName="BgCtrl" PropertyName="Focusable" Value="False"/>
        </b:StoryboardCompletedTrigger>
        <b:EventTrigger x:Name="RemoveFocusWhenClickingBackground" EventName="PreviewMouseDown">
          <b:ChangePropertyAction TargetName="BgCtrl" PropertyName="Focusable" Value="True"/>
          <noesis:SetFocusAction TargetName="BgCtrl"/>
          <b:ChangePropertyAction TargetName="BgCtrl" PropertyName="Focusable" Value="False"/>
        </b:EventTrigger>
      </b:Interaction.Triggers>
      <Canvas HorizontalAlignment="Left" VerticalAlignment="Bottom">
        <Image Source="Images/Space.png" Width="1100" Canvas.Left="0" Canvas.Bottom="0">
          <Image.OpacityMask>
            <RadialGradientBrush RadiusY="1" RadiusX="1" GradientOrigin="0,1" Center="0,1">
              <GradientStop Color="#FF000000" Offset="0.8"/>
              <GradientStop Offset="1" Color="#00000000"/>
            </RadialGradientBrush>
          </Image.OpacityMask>
        </Image>
      </Canvas>
      <Control x:Name="BgCtrl" Focusable="False"/>
      <ListBox ItemsSource="{Binding Path=SolarSystemObjects}" Margin="10,10,10,10" ItemContainerStyle="{StaticResource PlanetContainerStyle}" Template="{StaticResource PlanetsListTemplate}" ItemsPanel="{StaticResource PlanetsListPanel}" ItemTemplate="{StaticResource SolarSystemObjectTemplate}" Focusable="False"/>
    </Grid>
  </noesis:LayoutScaler>
</Page>
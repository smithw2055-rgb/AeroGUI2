              <ContentControl x:Name="SlotRight" RenderTransformOrigin="0.5,0.5" Content="{Binding Path=Player.Slots[6], Mode=TwoWay}" Grid.Column="2" Grid.Row="4" Style="{StaticResource Inventory.Style.EquipSlot.Right}" noesis:DragDrop.Kind="{Binding Path=Player.Slots[6].Category}" noesis:DragDrop.AutoTransfer="False" noesis:DragDrop.DefaultContent="{Binding Path=Defaults[5]}">
                <ContentControl.RenderTransform>
                  <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                  </TransformGroup>
                </ContentControl.RenderTransform>
              </ContentControl>
              <ContentControl x:Name="SlotFeet" Content="{Binding Path=Player.Slots[7], Mode=TwoWay}" Grid.Column="2" Grid.Row="6" Style="{StaticResource Inventory.Style.EquipSlot.Right}" noesis:DragDrop.Kind="{Binding Path=Player.Slots[7].Category}" noesis:DragDrop.DefaultContent="{Binding Path=Defaults[4]}"/>
            </Grid>
          </Grid>
          <Border x:Name="EquipTitleFade" RenderTransformOrigin="1.0,1.0" IsHitTestVisible="False" d:IsLocked="True">
            <Border.Background>
              <SolidColorBrush Color="#FFEAC067"/>
            </Border.Background>
            <Border.RenderTransform>
              <TransformGroup>
                <ScaleTransform ScaleX="0"/>
                <SkewTransform/>
                <RotateTransform/>
                <TranslateTransform/>
              </TransformGroup>
            </Border.RenderTransform>
          </Border>
          <Border x:Name="EquipFade" RenderTransformOrigin="1,0" Grid.ColumnSpan="6" Grid.Row="1" IsHitTestVisible="False" d:IsLocked="True">
            <Border.Background>
              <SolidColorBrush Color="#FF171712" Opacity="0.7"/>
            </Border.Background>
            <Border.RenderTransform>
              <TransformGroup>
                <ScaleTransform ScaleY="0"/>
                <SkewTransform/>
                <RotateTransform/>
                <TranslateTransform/>
              </TransformGroup>
            </Border.RenderTransform>
          </Border>
        </Grid>
      </Grid>
      <Grid x:Name="InventoryPanel" Margin="0.5,0,0,0" Column="2" Row="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="100*"/>
          <RowDefinition Height="900*"/>
        </Grid.RowDefinitions>
        <Grid.Transform3D>
          <noesis:CompositeTransform3D RotationY="5"/>
        </Grid.Transform3D>
        <Grid x:Name="InventoryTitle">
          <Grid.RowDefinitions>
            <RowDefinition Height="97*"/>
            <RowDefinition Height="3*"/>
          </Grid.RowDefinitions>
          <Border x:Name="InventoryTitleLine" Grid.Row="1">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0" Color="#00EAC067"/>
                <GradientStop Offset="0.75" Color="#CCEAC067"/>
                <GradientStop Offset="1" Color="#00EAC067"/>
              </LinearGradientBrush>
            </Border.Background>
            <Border.RenderTransform>
              <TransformGroup>
                <ScaleTransform ScaleX="0"/>
                <SkewTransform/>
                <RotateTransform/>
                <TranslateTransform/>
              </TransformGroup>
            </Border.RenderTransform>
          </Border>
          <Viewbox Margin="0,2">
            <TextBlock x:Name="InventoryText" RenderTransformOrigin="0.5,0.5" Text="INVENTORY" FontFamily="Fonts/#Sequel" FontSize="12" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource Inventory.Style.TitleBarText}">
              <TextBlock.RenderTransform>
                <TransformGroup>
                  <ScaleTransform/>
                  <SkewTransform/>
                  <RotateTransform/>
                  <TranslateTransform/>
                </TransformGroup>
              </TextBlock.RenderTransform>
            </TextBlock>
          </Viewbox>
        </Grid>
        <Grid x:Name="Inventory" Row="1">
          <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#66171712"/>
              <GradientStop Offset="1" Color="#0C171712"/>
            </LinearGradientBrush>
          </Grid.Background>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Decorator Width="{Binding ActualWidth, ElementName=MarginRef}" Height="{Binding ActualHeight, ElementName=MarginRef}" Grid.Column="0" Grid.Row="0"/>
          <Decorator Width="{Binding ActualWidth, ElementName=MarginRef}" Height="{Binding ActualHeight, ElementName=MarginRef}" Grid.Column="2" Grid.Row="2"/>
          <ScrollViewer ScrollViewer.PanningMode="VerticalFirst" ScrollViewer.CanContentScroll="True" Grid.Column="1" Grid.Row="1" Template="{StaticResource Inventory.Template.ScrollViewer}" Focusable="False" KeyboardNavigation.DirectionalNavigation="Continue">
            <ListBox x:Name="InventoryListBox" ItemsSource="{Binding Path=Inventory}" Template="{StaticResource Inventory.Template.ListBox}" ItemsPanel="{StaticResource Inventory.Template.ListBox.ItemsPanel}" ItemContainerStyle="{StaticResource Inventory.Style.ListBox.ItemContainer}" ItemTemplate="{StaticResource Inventory.Template.ListBox.Item}"/>
          </ScrollViewer>
        </Grid>
        <Border x:Name="InventoryTitleFade" RenderTransformOrigin="1.0,1.0" IsHitTestVisible="False" d:IsLocked="True">
          <Border.Background>
            <SolidColorBrush Color="#FFEAC067"/>
          </Border.Background>
          <Border.RenderTransform>
            <TransformGroup>
              <ScaleTransform ScaleX="0"/>
              <SkewTransform/>
              <RotateTransform/>
              <TranslateTransform/>
            </TransformGroup>
          </Border.RenderTransform>
        </Border>
        <Border x:Name="InventoryFade" RenderTransformOrigin="1.0,0.0" Grid.Row="1" IsHitTestVisible="False" d:IsLocked="True">
          <Border.Background>
            <SolidColorBrush Color="#FF171612" Opacity="0.7"/>
          </Border.Background>
          <Border.RenderTransform>
            <TransformGroup>
              <ScaleTransform ScaleY="0"/>
              <SkewTransform/>
              <RotateTransform/>
              <TranslateTransform/>
            </TransformGroup>
          </Border.RenderTransform>
        </Border>
      </Grid>
      <Grid x:Name="HelpPanel" Column="1" Grid.ColumnSpan="2" Row="3">
        <Grid.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="1" Color="#66171712"/>
            <GradientStop Color="#0C171712"/>
          </LinearGradientBrush>
        </Grid.Background>
        <Grid.RenderTransform>
          <TransformGroup>
            <ScaleTransform/>
            <SkewTransform/>
            <RotateTransform/>
            <TranslateTransform/>
          </TransformGroup>
        </Grid.RenderTransform>
        <Viewbox HorizontalAlignment="Right">
          <b:Interaction.Triggers>
            <b:DataTrigger Binding="{Binding Platform}" Value="PC">
              <b:ChangePropertyAction TargetName="SelectPC" PropertyName="Visibility" Value="Visible"/>
              <b:ChangePropertyAction TargetName="SelectXBOX" PropertyName="Visibility" Value="Collapsed"/>
              <b:ChangePropertyAction TargetName="SelectPS4" PropertyName="Visibility" Value="Collapsed"/>
              <b:ChangePropertyAction TargetName="CancelPC" PropertyName="Visibility" Value="Visible"/>
              <b:ChangePropertyAction TargetName="CancelXBOX" PropertyName="Visibility" Value="Collapsed"/>
              <b:ChangePropertyAction TargetName="CancelPS4" PropertyName="Visibility" Value="Collapsed"/>
            </b:DataTrigger>
            <b:DataTrigger Binding="{Binding Platform}" Value="XBOX">
              <b:ChangePropertyAction TargetName="SelectPC" PropertyName="Visibility" Value="Collapsed"/>
              <b:ChangePropertyAction TargetName="SelectXBOX" PropertyName="Visibility" Value="Visible"/>
              <b:ChangePropertyAction TargetName="SelectPS4" PropertyName="Visibility" Value="Collapsed"/>
              <b:ChangePropertyAction TargetName="CancelPC" PropertyName="Visibility" Value="Collapsed"/>
              <b:ChangePropertyAction TargetName="CancelXBOX" PropertyName="Visibility" Value="Visible"/>
              <b:ChangePropertyAction TargetName="CancelPS4" PropertyName="Visibility" Value="Collapsed"/>
            </b:DataTrigger>
            <b:DataTrigger Binding="{Binding Platform}" Value="PS4">
              <b:ChangePropertyAction TargetName="SelectPC" PropertyName="Visibility" Value="Collapsed"/>
              <b:ChangePropertyAction TargetName="SelectXBOX" PropertyName="Visibility" Value="Collapsed"/>
              <b:ChangePropertyAction TargetName="SelectPS4" PropertyName="Visibility" Value="Visible"/>
              <b:ChangePropertyAction TargetName="CancelPC" PropertyName="Visibility" Value="Collapsed"/>
              <b:ChangePropertyAction TargetName="CancelXBOX" PropertyName="Visibility" Value="Collapsed"/>
              <b:ChangePropertyAction TargetName="CancelPS4" PropertyName="Visibility" Value="Visible"/>
            </b:DataTrigger>
          </b:Interaction.Triggers>
          <StackPanel x:Name="HelpOptions" Orientation="Horizontal" UseLayoutRounding="False">
            <Border x:Name="SelectPC" Margin="0,5,5,5" Padding="4,0" Background="#66C9B69C" CornerRadius="2">
              <Border Width="12" Height="4" BorderBrush="#7FFFFFFF" BorderThickness="1,0,1,1" CornerRadius="0,0,0.5,0.5"/>
            </Border>
            <Grid x:Name="SelectXBOX" Margin="0,5,5,5">
              <Ellipse Width="11" Height="11" Fill="#FF299900"/>
              <TextBlock Text="A" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#7FFFFFFF" FontFamily="Fonts/#Sequel" FontSize="8"/>
            </Grid>
            <Grid x:Name="SelectPS4" Margin="0,5,5,5">
              <Ellipse Width="11" Height="11" Fill="#FF1A1C1E"/>
              <Path Data="M0,0 L6,6 M6,0 L0,6" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="#FF5781C0" StrokeThickness="0.5"/>
            </Grid>
            <TextBlock Text="Select item" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="#7FFFFFFF" FontSize="10"/>
            <Rectangle Width="0.5" Margin="10,5" Fill="#3FFFFFFF"/>
            <Border x:Name="CancelPC" Margin="5" Padding="4,0" Background="#66C9B69C" CornerRadius="2">
              <TextBlock Text="ESC" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#7FFFFFFF" FontFamily="Fonts/#Sequel" FontSize="8"/>
            </Border>
            <Grid x:Name="CancelXBOX" Margin="0,5,5,5">
              <Ellipse Width="11" Height="11" Fill="#FFC12810"/>
              <TextBlock Text="B" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#7FFFFFFF" FontFamily="Fonts/#Sequel" FontSize="8"/>
            </Grid>
            <Grid x:Name="CancelPS4" Margin="0,5,5,5">
              <Ellipse Width="{Binding ActualHeight, Mode=OneWay, RelativeSource={RelativeSource Self}}" Fill="#FF1A1C1E"/>
              <Ellipse Width="8" Height="8" Stroke="#FFE74C6C" StrokeThickness="0.5"/>
            </Grid>
            <TextBlock Text="Cancel selection" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#7FFFFFFF" FontSize="10"/>
          </StackPanel>
        </Viewbox>
      </Grid>
    </Grid>
  </noesis:LayoutScaler>
</Page>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Samples.V3.ControlGallery.MainWindow"
        Title="AeroGUI v3 - Control Gallery"
        Width="860"
        Height="640"
        Background="#FF0F172A">
  <Window.Resources>
    <ResourceDictionary>
      <SolidColorBrush x:Key="SurfaceBg" Color="#FF1E293B"/>
      <SolidColorBrush x:Key="CardBorder" Color="#FF334155"/>

      <Style x:Key="PillButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#FF2563EB"/>
        <Setter Property="Foreground" Value="#FFFFFFFF"/>
        <Setter Property="BorderBrush" Value="#FF60A5FA"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="16"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter Content="{TemplateBinding Content}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Background" Value="#FF1D4ED8"/>
          </Trigger>
          <Trigger Property="IsPressed" Value="True">
            <Setter Property="Background" Value="#FF1E40AF"/>
          </Trigger>
        </Style.Triggers>
      </Style>

      <Style x:Key="StatusPillStyle" TargetType="Border">
        <Setter Property="Background" Value="#FF334155"/>
        <Setter Property="BorderBrush" Value="#FF475569"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="10,6"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding CompactMode}" Value="True">
            <Setter Property="Background" Value="#FF065F46"/>
            <Setter Property="BorderBrush" Value="#FF10B981"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <DockPanel LastChildFill="True">
    <Menu x:Name="TopMenu" DockPanel.Dock="Top" Background="#FF1E293B">
      <MenuItem x:Name="FileMenu" Header="File">
        <MenuItem x:Name="RefreshItem" Header="Refresh Gallery" Click="OnMenuRefreshClick"/>
        <MenuItem x:Name="CompactMenuItem" Header="Compact Density" IsCheckable="True" Click="OnMenuCompactToggle"/>
      </MenuItem>
      <MenuItem x:Name="ViewMenu" Header="View">
        <MenuItem Header="Show Hierarchy" Click="OnMenuSelectHierarchyTab"/>
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Bottom" Background="#FF1E293B" Padding="14,8" BorderBrush="#FF334155" BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Border x:Name="CompactStatusBadge" Style="{StaticResource StatusPillStyle}">
          <TextBlock x:Name="CompactStatusLabel" Text="{Binding DensityLabel}" FontSize="12" Foreground="#FFF8FAFC"/>
        </Border>
        <TextBlock x:Name="GalleryStatusText" Text="{Binding StatusText}" FontSize="13" Foreground="#FFCBD5E1" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>

    <Border Padding="16">
      <TabControl x:Name="GalleryTabs">
        <TabItem x:Name="TabInputs" Header="Interactive Controls">
          <ScrollViewer x:Name="CardScroller" VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical" Spacing="12" Padding="8">
              <Border Background="{StaticResource SurfaceBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel Orientation="Vertical" Spacing="10">
                  <TextBlock Text="Custom ControlTemplate &amp; Triggers" FontSize="16" FontWeight="Bold" Foreground="#FFF8FAFC"/>
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="TemplatedPillBtn" Style="{StaticResource PillButtonStyle}" Content="Pill Action" Width="140" Height="38" Click="OnPillButtonClick"/>
                    <ComboBox x:Name="ThemeCombo" Width="180" Height="34" SelectedIndex="{Binding SelectedThemeIndex, Mode=TwoWay}">
                      <ComboBoxItem Content="Midnight Slate"/>
                      <ComboBoxItem Content="Cobalt Blue"/>
                      <ComboBoxItem Content="Emerald High-Contrast"/>
                    </ComboBox>
                    <CheckBox x:Name="CompactModeCheck" Content="Compact Mode" IsChecked="{Binding CompactMode, Mode=TwoWay}" Foreground="#FFE2E8F0"/>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Expander x:Name="FeatureExpander" Header="Expandable Telemetry Details" IsExpanded="True">
                <StackPanel Orientation="Vertical" Spacing="8" Padding="6">
                  <TextBlock Text="Scrollable cards demonstrating ScrollViewer wheel scrolling and Expander state." Foreground="#FFCBD5E1"/>
                  <Border Height="90" Background="#FF0B1120" CornerRadius="6" Padding="10">
                    <TextBlock Text="Module 01: VisualWorld Retained Scene Graph" Foreground="#FF93C5FD"/>
                  </Border>
                  <Border Height="90" Background="#FF0B1120" CornerRadius="6" Padding="10">
                    <TextBlock Text="Module 02: 64-Level Depth-Bucket Layout Solver" Foreground="#FF93C5FD"/>
                  </Border>
                  <Border Height="90" Background="#FF0B1120" CornerRadius="6" Padding="10">
                    <TextBlock Text="Module 03: Paged 4KB UberShader Command Stream" Foreground="#FF93C5FD"/>
                  </Border>
                  <Border Height="90" Background="#FF0B1120" CornerRadius="6" Padding="10">
                    <TextBlock Text="Module 04: Zero-RTTI Dual-Domain Binding Bridge" Foreground="#FF93C5FD"/>
                  </Border>
                </StackPanel>
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem x:Name="TabHierarchy" Header="Component Tree">
          <Border Padding="12" Background="#FF0B1120" CornerRadius="8">
            <TreeView x:Name="ComponentTree">
              <TreeViewItem x:Name="RootTreeNode" Header="AeroGUI v3 Microkernel" IsExpanded="True">
                <TreeViewItem x:Name="VisualTreeNode" Header="VisualWorld (5 Primitives)"/>
                <TreeViewItem Header="PagedRenderTree (4KB CommandPages)"/>
                <TreeViewItem Header="DesktopEventHost (0% Idle CPU)"/>
              </TreeViewItem>
              <TreeViewItem Header="RealScript Aero.UI Framework">
                <TreeViewItem Header="BindingEngine &amp; Triggers"/>
                <TreeViewItem Header="ControlTemplates &amp; Styles"/>
              </TreeViewItem>
            </TreeView>
          </Border>
        </TabItem>

        <TabItem x:Name="TabSummary" Header="Resources &amp; Styles">
          <Border Padding="16" Background="#FF1E293B" CornerRadius="8">
            <StackPanel Orientation="Vertical" Spacing="8">
              <TextBlock Text="Style, ResourceDictionary, Trigger &amp; DataTrigger Active" FontSize="16" FontWeight="Bold" Foreground="#FFF8FAFC"/>
              <TextBlock Text="{Binding ThemeSummary}" Foreground="#FF93C5FD"/>
            </StackPanel>
          </Border>
        </TabItem>
      </TabControl>
    </Border>
  </DockPanel>
</Window>

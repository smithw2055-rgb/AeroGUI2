<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Samples.V3.VectorAndCanvas.MainWindow"
        Title="AeroGUI v3 — Vector &amp; Retained Canvas"
        Width="860"
        Height="580"
        Background="#FF0D1117">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FF161B22" BorderBrush="#FF30363D" BorderThickness="1"
                CornerRadius="12" Padding="18" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <StackPanel Width="460" Spacing="4">
                    <TextBlock Text="Vector Shapes, Gradients, 3D Transforms &amp; Retained Canvas"
                               FontSize="20" Foreground="#FFF8FAFC" />
                    <TextBlock x:Name="VectorStatusText"
                               Text="Path SVG + Linear/Radial Gradients + Blur/Shadow + CustomDrawElement + Storyboard"
                               FontSize="12" Foreground="#FF94A3B8" />
                </StackPanel>
                <Button x:Name="AnimateBtn" Content="Play Storyboard" Padding="14,8"
                        Background="#FF2563EB" Foreground="#FFFFFFFF" CornerRadius="8" />
                <Button x:Name="PulseCanvasBtn" Content="Step Waveform" Padding="14,8"
                        Background="#FF10B981" Foreground="#FFFFFFFF" CornerRadius="8" />
            </StackPanel>
        </Border>

        <!-- Two-Column Workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Column: Vector Path, Radial Orb, Blur & 3D Transform Card -->
            <StackPanel Grid.Column="0" Spacing="14" Margin="0,0,16,0">
                <Border x:Name="Card3D" Background="#FF1E293B" BorderBrush="#FF475569" BorderThickness="1"
                        CornerRadius="12" Padding="16"
                        Rotation3DX="6" Rotation3DY="-8" CameraDistance="900">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="6" Direction="315" Color="#AA000000" Opacity="0.6" />
                    </Border.Effect>
                    <Border.RenderTransform>
                        <TransformGroup>
                            <TransformGroup.Children>
                                <RotateTransform Angle="2" />
                                <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                            </TransformGroup.Children>
                        </TransformGroup>
                    </Border.RenderTransform>
                    <StackPanel Spacing="10">
                        <TextBlock Text="Vector Path + LinearGradientBrush + 3D Card" FontSize="14" Foreground="#FFE2E8F0" />
                        <Path x:Name="HeroVectorBadge"
                              Width="220" Height="110"
                              Data="M 110,10 L 140,70 L 205,78 L 156,122 L 168,186 L 110,154 L 52,186 L 64,122 L 15,78 L 80,70 Z"
                              Stroke="#FFF8FAFC" StrokeThickness="2" Stretch="Uniform">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Offset="0.0" Color="#FF38BDF8" />
                                    <GradientStop Offset="0.5" Color="#FF818CF8" />
                                    <GradientStop Offset="1.0" Color="#FFF472B6" />
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border x:Name="RadialOrbHost" Width="170" Height="110" CornerRadius="12"
                            BorderBrush="#FF38BDF8" BorderThickness="1" Padding="10">
                        <TextBlock Text="RadialGradientBrush" FontSize="12" Foreground="#FFF8FAFC"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border x:Name="GlassBlurBox" Width="190" Height="110" CornerRadius="12"
                            Background="#FF334155" BorderBrush="#FF64748B" BorderThickness="1" Padding="10">
                        <Border.Effect>
                            <BlurEffect Radius="2" />
                        </Border.Effect>
                        <TextBlock Text="BlurEffect + Skew" FontSize="12" Foreground="#FFE2E8F0"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- Right Column: Retained CustomDrawElement Canvas -->
            <Border Grid.Column="1" Background="#FF0F172A" BorderBrush="#FF334155" BorderThickness="1"
                    CornerRadius="12" Padding="14">
                <StackPanel Spacing="10">
                    <TextBlock Text="Retained DrawingCommandBuffer (CustomDrawElement)"
                               FontSize="14" Foreground="#FFE2E8F0" />
                    <Border x:Name="CanvasHost" Width="410" Height="370"
                            Background="#FF020617" BorderBrush="#FF1E293B" BorderThickness="1" CornerRadius="8" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

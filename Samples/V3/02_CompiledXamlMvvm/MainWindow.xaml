<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Samples.V3.Mvvm.MainWindow"
        x:DataType="MainViewModel"
        Title="AeroGUI v3 - Compiled XAML MVVM"
        Width="760"
        Height="560"
        Background="#FF0F172A">
  <Window.Resources>
    <ResourceDictionary>
      <SolidColorBrush x:Key="PanelSurface" Color="#FF1E293B"/>
      <SolidColorBrush x:Key="CardBorder" Color="#FF334155"/>
      <Style TargetType="Button">
        <Setter Property="Background" Value="#FF2563EB"/>
        <Setter Property="Foreground" Value="#FFFFFFFF"/>
        <Setter Property="BorderBrush" Value="#FF3B82F6"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="12,6"/>
      </Style>
      <Style TargetType="TextBox">
        <Setter Property="Background" Value="#FF0B1120"/>
        <Setter Property="Foreground" Value="#FFF8FAFC"/>
        <Setter Property="BorderBrush" Value="#FF475569"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <Border Padding="20" Background="#FF0F172A">
    <Grid RowSpacing="14">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="{StaticResource PanelSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="16">
        <StackPanel Orientation="Vertical" Spacing="6">
          <TextBlock Text="Compiled XAML + MVVM Workbench" FontSize="22" FontWeight="Bold" Foreground="#FFF8FAFC"/>
          <TextBlock x:Name="SummaryText" Text="{Binding SummaryLine}" FontSize="13" Foreground="#FF94A3B8"/>
        </StackPanel>
      </Border>

      <Border Grid.Row="1" Background="{StaticResource PanelSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="16">
        <StackPanel Orientation="Vertical" Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Task Title:" Width="88" VerticalAlignment="Center" Foreground="#FFCBD5E1"/>
            <TextBox x:Name="TitleInput" Width="280" Text="{Binding DraftTitle, Mode=TwoWay}" PlaceholderText="Type task name..."/>
            <Button x:Name="AddTaskBtn" Content="Add Task" Width="110" Height="34" Command="{Binding AddTaskCommand}"/>
            <Button x:Name="PopTaskBtn" Content="Remove First" Width="120" Height="34" Background="#FF334155" BorderBrush="#FF475569" Command="{Binding RemoveFirstCommand}"/>
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Priority:" Width="88" VerticalAlignment="Center" Foreground="#FFCBD5E1"/>
            <Slider x:Name="PrioritySlider" Width="220" Minimum="0" Maximum="100" Value="{Binding PriorityScore, Mode=TwoWay}"/>
            <ProgressBar x:Name="PriorityBar" Width="170" Height="14" Minimum="0" Maximum="100" Value="{Binding PriorityScore}"/>
            <TextBlock x:Name="TitlePreview" Text="{Binding DraftTitle}" Foreground="#FF38BDF8" VerticalAlignment="Center"/>
          </StackPanel>

          <CheckBox x:Name="UrgentCheck" Content="Mark Urgent" IsChecked="{Binding IsUrgent, Mode=TwoWay}" Foreground="#FFE2E8F0"/>
        </StackPanel>
      </Border>

      <Border Grid.Row="2" Background="{StaticResource PanelSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="12">
        <ListBox x:Name="TaskList" ItemsSource="{Binding Tasks}" Background="#FF0B1120" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="TaskItem">
              <Border Padding="8,6" Margin="0,0,0,4" Background="#FF172554" CornerRadius="6">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="#FFF8FAFC" Width="280"/>
                  <TextBlock Text="{Binding Badge}" FontSize="12" Foreground="#FF93C5FD"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <TextBlock x:Name="FooterText" Grid.Row="3" Text="{Binding StatusMessage}" FontSize="12" Foreground="#FFCBD5E1"/>
    </Grid>
  </Border>
</Window>

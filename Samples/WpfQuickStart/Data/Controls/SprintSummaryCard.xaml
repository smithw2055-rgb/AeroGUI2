<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WpfQuickStart.SprintSummaryCard"
             Padding="8,6,8,6">
  <Border Background="#20293D" CornerRadius="5" Padding="10,6,10,6" BorderBrush="#334B6E" BorderThickness="1">
    <StackPanel Orientation="Horizontal" Spacing="10">
      <TextBlock x:Name="BadgeLabel" Text="Sprint Velocity: Normal" Foreground="#E6EDF7" FontSize="13" VerticalAlignment="Center"/>
      <Button x:Name="BoostBtn" Content="Boost" Click="BoostBtn_Click" Padding="8,2,8,2"/>
    </StackPanel>
  </Border>
</UserControl>

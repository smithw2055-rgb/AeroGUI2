<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WpfQuickStart.MainWindow"
        Title="AeroGUI WPF QuickStart"
        Width="960" Height="600"
        Background="{StaticResource AppSurfaceBrush}">
  <DockPanel LastChildFill="True">
    <Menu DockPanel.Dock="Top" Background="#191F2E" Padding="8,4,8,4">
      <MenuItem Header="File" InputGestureText="Alt+F">
        <MenuItem x:Name="ResetMenuItem" Header="Reset Board" Command="{Binding ResetBoardCommand}"/>
        <Separator/>
        <MenuItem Header="Close Window"/>
      </MenuItem>
      <MenuItem Header="View">
        <MenuItem Header="Compact Mode" IsCheckable="True" IsChecked="False"/>
      </MenuItem>
    </Menu>

    <ToolBar DockPanel.Dock="Top" Background="#1B2233" Padding="8,6,8,6">
      <Button x:Name="QuickFillButton" Content="Quick Fill" Click="QuickFillButton_Click" Padding="10,4,10,4"/>
      <Separator Width="1" Height="18" Margin="6,0,6,0"/>
      <Button x:Name="AddTaskButton" Content="Add Task" Command="{Binding AddTaskCommand}" Padding="10,4,10,4"/>
      <CheckBox x:Name="TriStateCheck" Content="Tri-State Gate" IsThreeState="True" Margin="12,0,0,0" Foreground="{StaticResource PrimaryTextBrush}"/>
    </ToolBar>

    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem x:Name="StatusTextItem" Content="{Binding StatusMessage}" Foreground="{StaticResource MutedTextBrush}"/>
    </StatusBar>

    <Grid Margin="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240"/>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border x:Name="NavBorder" Grid.Column="0" Background="{StaticResource CardSurfaceBrush}" CornerRadius="6" Padding="8">
        <StackPanel Spacing="6">
          <TextBlock Text="Workspaces" FontSize="15" Foreground="{StaticResource PrimaryTextBrush}"/>
          <TreeView x:Name="CategoryTree">
            <TreeViewItem Header="Sprint Backlog" IsExpanded="True" IsSelected="True">
              <TreeViewItem Header="XAML Parser &amp; Compiler"/>
              <TreeViewItem Header="Controls &amp; Templates"/>
              <TreeViewItem Header="GPU &amp; Atlas Rendering"/>
            </TreeViewItem>
            <TreeViewItem Header="Archived Releases" IsExpanded="False">
              <TreeViewItem Header="v0.98 Baseline"/>
            </TreeViewItem>
          </TreeView>
        </StackPanel>
      </Border>

      <GridSplitter x:Name="MainSplitter" Grid.Column="1" Width="6"/>

      <Border Grid.Column="2" Background="{StaticResource CardSurfaceBrush}" CornerRadius="6" Padding="12">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock x:Name="HeaderBanner" Text="{Binding SelectedItem.Header, ElementName=CategoryTree, FallbackValue=Sprint Backlog}" FontSize="18" Foreground="{StaticResource PrimaryTextBrush}"/>
            <TextBlock x:Name="PaneSizeReadout" Foreground="{StaticResource MutedTextBrush}" FontSize="13">
              <Run Text="{Binding ActualWidth, ElementName=NavBorder, Mode=OneWay, StringFormat=F0}"/>x<Run Text="{Binding ActualHeight, ElementName=NavBorder, Mode=OneWay, StringFormat=F0}"/>
            </TextBlock>
          </StackPanel>

          <TextBox x:Name="NewTaskInput" Text="{Binding NewTaskTitle, Mode=TwoWay}" Placeholder="Enter new task title..." Padding="8,6,8,6"/>

          <ListBox x:Name="TasksList" ItemsSource="{Binding ActiveTasks}" Height="320"/>
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>

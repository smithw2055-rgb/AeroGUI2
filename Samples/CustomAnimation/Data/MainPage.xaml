<Page
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions"
  xmlns:customAnimations="clr-namespace:CustomAnimation"
  mc:Ignorable="d"
  Title="Custom Animations Sample"
  FontFamily="./#Aero Matics" d:DesignWidth="1280" d:DesignHeight="720">

  <Page.Resources>
    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="Background" Value="#E50A263D"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Margin" Value="16"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush">
        <Setter.Value>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0.0" Color="#FF154A6B"/>
            <GradientStop Offset="1.0" Color="#FF103952"/>
          </LinearGradientBrush>
        </Setter.Value>
      </Setter>
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="10" Opacity="0.2"/>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TitleStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#F8FAFC"/>
      <Setter Property="FontSize" Value="24"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="24,24,24,4"/>
    </Style>

    <Style x:Key="SubtitleStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#94A3B8"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Margin" Value="24,0,24,24"/>
    </Style>

    <Style x:Key="PrimaryButtonFocus" TargetType="Control">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Control">
            <Border Margin="-4" BorderBrush="#FF087599" BorderThickness="2" CornerRadius="8">
              <Border.Effect>
                <DropShadowEffect Color="#FF0099CC" BlurRadius="10" ShadowDepth="0" Opacity="0.8"/>
              </Border.Effect>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{StaticResource PrimaryButtonFocus}"/>
      <Setter Property="Background" Value="#FF087599"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Padding" Value="24,12"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}" TextElement.Foreground="{TemplateBinding Foreground}">
              <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="#FF006185"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="#FF065475"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Storyboard x:Key="BounceTimeline">
      <DoubleAnimation Storyboard.TargetName="BounceTarget" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
      <customAnimations:BounceAnimation Storyboard.TargetName="BounceTarget" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0" To="1" Duration="0:0:1.5" EdgeBehavior="EaseOut" Bounciness="2" Bounces="3"/>
      <customAnimations:BounceAnimation Storyboard.TargetName="BounceTarget" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0" To="1" Duration="0:0:1.5" EdgeBehavior="EaseOut" Bounciness="2" Bounces="3"/>
    </Storyboard>

    <Storyboard x:Key="ElasticTimeline">
      <customAnimations:ElasticAnimation Storyboard.TargetName="ElasticTarget" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="90" To="0" Duration="0:0:2.5" EdgeBehavior="EaseOut" Springiness="4" Oscillations="5"/>
    </Storyboard>

    <Storyboard x:Key="BackTimeline">
      <customAnimations:BackAnimation Storyboard.TargetName="BackTarget" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-200" To="0" Duration="0:0:0.5" EdgeBehavior="EaseOut" Amplitude="0.5" Suppression="5"/>
    </Storyboard>

    <Storyboard x:Key="ExpoTimeline">
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GaugeNeedle" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)">
        <LinearDoubleKeyFrame KeyTime="0:0:0.0" Value="-90"/>
        <EasingDoubleKeyFrame KeyTime="0:0:0.15" Value="-40">
          <EasingDoubleKeyFrame.EasingFunction><ExponentialEase EasingMode="EaseOut" Exponent="3"/></EasingDoubleKeyFrame.EasingFunction>
        </EasingDoubleKeyFrame>
        <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="-70">
          <EasingDoubleKeyFrame.EasingFunction><ExponentialEase EasingMode="EaseIn" Exponent="2"/></EasingDoubleKeyFrame.EasingFunction>
        </EasingDoubleKeyFrame>
        <EasingDoubleKeyFrame KeyTime="0:0:0.45" Value="-10">
          <EasingDoubleKeyFrame.EasingFunction><ExponentialEase EasingMode="EaseOut" Exponent="3"/></EasingDoubleKeyFrame.EasingFunction>
        </EasingDoubleKeyFrame>
        <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="-45">
          <EasingDoubleKeyFrame.EasingFunction><ExponentialEase EasingMode="EaseIn" Exponent="2"/></EasingDoubleKeyFrame.EasingFunction>
        </EasingDoubleKeyFrame>
        <EasingDoubleKeyFrame KeyTime="0:0:0.9" Value="85">
          <EasingDoubleKeyFrame.EasingFunction><ExponentialEase EasingMode="EaseOut" Exponent="4"/></EasingDoubleKeyFrame.EasingFunction>
        </EasingDoubleKeyFrame>
        <EasingDoubleKeyFrame KeyTime="0:0:1.7" Value="-90">
          <EasingDoubleKeyFrame.EasingFunction><ExponentialEase EasingMode="EaseOut" Exponent="3"/></EasingDoubleKeyFrame.EasingFunction>
        </EasingDoubleKeyFrame>
      </DoubleAnimationUsingKeyFrames>
    </Storyboard>

    <Storyboard x:Key="CircleTimeline" RepeatBehavior="Forever">
      <customAnimations:CircleAnimation Storyboard.TargetName="Dot1" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" Duration="0:0:2" Radius="40" Direction="XDirection" />
      <customAnimations:CircleAnimation Storyboard.TargetName="Dot1" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" Duration="0:0:2" Radius="40" Direction="YDirection" />
      <customAnimations:CircleAnimation Storyboard.TargetName="Dot2" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" Duration="0:0:2" Radius="40" Direction="XDirection" BeginTime="0:0:0.2" />
      <customAnimations:CircleAnimation Storyboard.TargetName="Dot2" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" Duration="0:0:2" Radius="40" Direction="YDirection" BeginTime="0:0:0.2" />
      <customAnimations:CircleAnimation Storyboard.TargetName="Dot3" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" Duration="0:0:2" Radius="40" Direction="XDirection" BeginTime="0:0:0.4" />
      <customAnimations:CircleAnimation Storyboard.TargetName="Dot3" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" Duration="0:0:2" Radius="40" Direction="YDirection" BeginTime="0:0:0.4" />
    </Storyboard>

    <Storyboard x:Key="ShakeTimeline">
      <customAnimations:ShakeAnimation Storyboard.TargetName="LockContainer" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="0" Amplitude="14" Oscillations="6" Duration="0:0:0.4" />
      <ColorAnimation Storyboard.TargetName="LockBackground" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" From="#FFEF4444" To="#FF061B2B" Duration="0:0:0.4" />
    </Storyboard>
  </Page.Resources>
  <Page.Background>
    <RadialGradientBrush GradientOrigin="0.25,0.2" RadiusY="1" RadiusX="1" Center="0.25,0.2">
      <GradientStop Offset="0.0" Color="#FF207F7F"/>
      <GradientStop Offset="0.3" Color="#FF124D7A"/>
      <GradientStop Offset="0.8" Color="#FF0C3452"/>
      <GradientStop Offset="1.0" Color="#FF0B2D47"/>
    </RadialGradientBrush>
  </Page.Background>
  <noesis:LayoutScaler ReferenceResolution="1280,720">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid Margin="40,35,40,15" Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Custom Animations Showcase" Grid.Column="0" VerticalAlignment="Center" Foreground="#F8FAFC" FontSize="42" FontWeight="SemiBold" noesis:Text.CharacterSpacing="-30"/>
        <Button Content="PLAY ALL ANIMATIONS" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource PrimaryButtonStyle}">
          <b:Interaction.Triggers>
            <b:EventTrigger x:Name="PlayCircleOnLoad" EventName="Loaded">
              <b:ControlStoryboardAction Storyboard="{StaticResource CircleTimeline}"/>
            </b:EventTrigger>
            <b:EventTrigger x:Name="PlayAllOnClick" EventName="Click">
              <b:ControlStoryboardAction Storyboard="{StaticResource BounceTimeline}"/>
              <b:ControlStoryboardAction Storyboard="{StaticResource ElasticTimeline}"/>
              <b:ControlStoryboardAction Storyboard="{StaticResource BackTimeline}"/>
              <b:ControlStoryboardAction Storyboard="{StaticResource ExpoTimeline}"/>
              <b:ControlStoryboardAction Storyboard="{StaticResource ShakeTimeline}"/>
            </b:EventTrigger>
          </b:Interaction.Triggers>
        </Button>
      </Grid>
      <UniformGrid Columns="3" Rows="2" Margin="24,0,24,24" Grid.Row="1">
        <Border Style="{StaticResource CardStyle}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
              <TextBlock Text="Bounce" Style="{StaticResource TitleStyle}"/>
              <TextBlock Text="ScaleTransform Pop-in" Style="{StaticResource SubtitleStyle}"/>
            </StackPanel>
            <Grid Margin="0,0,0,24" Row="1">
              <Ellipse Width="130" Height="130" Stroke="#FF154A6A" StrokeThickness="1" StrokeDashArray="4 4"/>
              <Ellipse x:Name="BounceTarget" RenderTransformOrigin="0.5,0.5" Width="80" Height="80" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#FF30C5E3">
                <Ellipse.RenderTransform>
                  <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Ellipse.RenderTransform>
              </Ellipse>
            </Grid>
          </Grid>
        </Border>
        <Border Style="{StaticResource CardStyle}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
              <TextBlock Text="Elastic" Style="{StaticResource TitleStyle}"/>
              <TextBlock Text="RotateTransform Pendulum" Style="{StaticResource SubtitleStyle}"/>
            </StackPanel>
            <Grid Margin="0,0,0,24" Grid.Row="1">
              <Grid VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Top" Fill="#FF154A6A"/>
                <Grid x:Name="ElasticTarget" RenderTransformOrigin="0.5, 0.04">
                  <Grid.RenderTransform>
                    <RotateTransform Angle="0"/>
                  </Grid.RenderTransform>
                  <Rectangle Width="2" Height="90" Margin="0,4,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Fill="#FF154A6A"/>
                  <Ellipse Width="40" Height="40" Margin="0,90,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Fill="#FF2AC9AF"/>
                </Grid>
              </Grid>
            </Grid>
          </Grid>
        </Border>
        <Border Style="{StaticResource CardStyle}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
              <TextBlock Text="Back" Style="{StaticResource TitleStyle}"/>
              <TextBlock Text="TranslateTransform Drawer" Style="{StaticResource SubtitleStyle}"/>
            </StackPanel>
            <Grid Margin="0,0,0,24" Row="1" ClipToBounds="True">
              <Border x:Name="BackTarget" Width="240" Height="70" Background="#061B2B" BorderBrush="#154A6B" BorderThickness="1" CornerRadius="8">
                <Border.RenderTransform>
                  <TranslateTransform X="0" Y="0"/>
                </Border.RenderTransform>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Background="#F59E0B" CornerRadius="8,0,0,8"/>
                  <StackPanel Margin="16,0,0,0" Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Alert Dispatcher" Foreground="#F8FAFC" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="System protocol altered." Margin="0,2,0,0" Foreground="#94A3B8" FontSize="12"/>
                  </StackPanel>
                </Grid>
              </Border>
            </Grid>
          </Grid>
        </Border>
        <Border Style="{StaticResource CardStyle}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
              <TextBlock Text="Exponential" Style="{StaticResource TitleStyle}"/>
              <TextBlock Text="High-Power Engine Rev" Style="{StaticResource SubtitleStyle}"/>
            </StackPanel>
            <Grid Margin="0,0,0,24" Row="1">
              <Canvas Width="180" Height="100">
                <Path Data="M 10,90 A 80,80 0 0,1 170,90" Stroke="#061B2B" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Path Data="M 10,90 A 80,80 0 0,1 170,90" Stroke="#154A6B" StrokeThickness="8" StrokeDashArray="0.4 4" StrokeDashCap="Round"/>
                <Path Data="M 146.5,33.5 A 80,80 0 0,1 170,90" Stroke="#EF4444" StrokeThickness="8" StrokeEndLineCap="Round"/>
                <Ellipse Width="28" Height="28" Canvas.Left="76" Canvas.Top="76" Fill="#061B2B" Stroke="#154A6B" StrokeThickness="1"/>
                <Rectangle x:Name="GaugeNeedle" RenderTransformOrigin="0.5, 1" RadiusX="2" RadiusY="2" Width="4" Height="75" Canvas.Left="88" Canvas.Top="15" Fill="#EF4444">
                  <Rectangle.RenderTransform>
                    <RotateTransform Angle="-90"/>
                  </Rectangle.RenderTransform>
                </Rectangle>
                <Ellipse Width="10" Height="10" Canvas.Left="85" Canvas.Top="85" Fill="#F8FAFC"/>
              </Canvas>
            </Grid>
          </Grid>
        </Border>
        <Border Style="{StaticResource CardStyle}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
              <TextBlock Text="Circular" Style="{StaticResource TitleStyle}"/>
              <TextBlock Text="Continuous Orbital Loading" Style="{StaticResource SubtitleStyle}"/>
            </StackPanel>
            <Grid Margin="0,0,0,24" Row="1">
              <Grid>
                <Ellipse x:Name="Dot1" Width="16" Height="16" Fill="#FF306BE3">
                  <Ellipse.RenderTransform>
                    <TranslateTransform X="-40" Y="0"/>
                  </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="Dot2" Width="13" Height="13" Opacity="0.7" Fill="#FF306BE3">
                  <Ellipse.RenderTransform>
                    <TranslateTransform X="-40" Y="0"/>
                  </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="Dot3" Width="10" Height="10" Opacity="0.4" Fill="#FF306BE3">
                  <Ellipse.RenderTransform>
                    <TranslateTransform X="-40" Y="0"/>
                  </Ellipse.RenderTransform>
                </Ellipse>
              </Grid>
            </Grid>
          </Grid>
        </Border>
        <Border Style="{StaticResource CardStyle}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
              <TextBlock Text="Procedural Shake" Style="{StaticResource TitleStyle}"/>
              <TextBlock Text="High-Frequency Decaying Math" Style="{StaticResource SubtitleStyle}"/>
            </StackPanel>
            <Grid Margin="0,0,0,24" Row="1">
              <Border x:Name="LockContainer" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                  <TranslateTransform X="0" Y="0"/>
                </Border.RenderTransform>
                <Border x:Name="LockBackground" Width="160" Height="60" Background="#FF061B2B" BorderBrush="#154A6B" BorderThickness="1" CornerRadius="8">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="M 6,8 V 5 A 4,4 0 0,1 14,5 V 8 H 15 V 16 H 5 V 8 Z M 8,8 H 12 V 5 A 2,2 0 0,0 8,5 Z" Stretch="Uniform" Width="16" Height="16" Margin="0,0,12,0" Fill="#F8FAFC"/>
                    <TextBlock Text="SECURE" VerticalAlignment="Center" Foreground="#F8FAFC" FontSize="18" FontWeight="SemiBold" noesis:Text.CharacterSpacing="220"/>
                  </StackPanel>
                </Border>
              </Border>
            </Grid>
          </Grid>
        </Border>
      </UniformGrid>
    </Grid>
  </noesis:LayoutScaler>
</Page>